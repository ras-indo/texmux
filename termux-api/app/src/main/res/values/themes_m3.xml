<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3 DayNight theme with Dynamic Colors (Monet) support.
        Falls back gracefully on pre-Android 12 devices.
    -->
    <style name="Theme.TermuxAPI.Material3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <!-- AppBar / Toolbar -->
        <item name="colorPrimarySurface">@color/m3_surface</item>
        <item name="colorOnPrimarySurface">@color/m3_on_surface</item>
        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.LargeComponent</item>
    </style>

    <!-- Day-night aware static colors (fallback when Dynamic Colors unavailable) -->
    <color name="m3_primary">@color/m3_primary_light</color>
    <color name="m3_on_primary">@color/m3_on_primary_light</color>
    <color name="m3_primary_container">@color/m3_primary_container_light</color>
    <color name="m3_on_primary_container">@color/m3_on_primary_container_light</color>
    <color name="m3_secondary">@color/m3_secondary_light</color>
    <color name="m3_on_secondary">@color/m3_on_secondary_light</color>
    <color name="m3_secondary_container">@color/m3_secondary_container_light</color>
    <color name="m3_on_secondary_container">@color/m3_on_secondary_container_light</color>
    <color name="m3_tertiary">@color/m3_tertiary_light</color>
    <color name="m3_on_tertiary">@color/m3_on_tertiary_light</color>
    <color name="m3_error">@color/m3_error_light</color>
    <color name="m3_on_error">@color/m3_on_error_light</color>
    <color name="m3_background">@color/m3_background_light</color>
    <color name="m3_on_background">@color/m3_on_background_light</color>
    <color name="m3_surface">@color/m3_surface_light</color>
    <color name="m3_on_surface">@color/m3_on_surface_light</color>
</resources>
