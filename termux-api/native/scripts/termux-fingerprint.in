#!@TERMUX_PREFIX@/bin/sh
#
# NAME
#     termux-fingerprint — Use fingerprint sensor for authentication
#
# SYNOPSIS
#     termux-fingerprint [-t title] [-d description] [-s subtitle] [-c cancel]
#
# DESCRIPTION
#     Authenticate the user via the device's fingerprint sensor. Shows a
#     system dialog prompting the user to scan their fingerprint. Returns
#     a JSON result indicating success (fingerprint matched) or failure
#     (no match, too many attempts, or cancelled).
#
#     Only available on devices with a fingerprint sensor running
#     Android 6.0 (Marshmallow, API 23) or later. On devices without a
#     fingerprint sensor or on older Android versions, the command will
#     fail with an appropriate error message.
#
#     The dialog title, description, subtitle, and cancel button text
#     can be customized via the optional flags.
#
# OPTIONS
#     -t title        title for the authentication dialog
#     -d description  description for the authentication dialog
#     -s subtitle     subtitle for the authentication dialog
#     -c cancel       cancel label for the authentication dialog
#
# EXAMPLES
#     # Authenticate with a custom title and description
#     termux-fingerprint -t "Verify" -d "Place your finger on the sensor"
#
set -e -u

SCRIPTNAME=termux-fingerprint
show_usage () {
    cat <<EOF
Usage: $SCRIPTNAME [-t title] [-d description] [-s subtitle] [-c cancel]

Authenticate using the device's fingerprint (or biometric) sensor.
Prompts the user to scan their fingerprint and returns the result.
On Android 9+ (API 28+), this uses BiometricPrompt which may support
face and iris recognition in addition to fingerprints.

OUTPUT:
  JSON object with result:
    success   (boolean) — Whether authentication was successful
    error     (string)  — Error description on failure (e.g.,
                          "fingerprint_not_recognized", "too_many_attempts",
                          "cancelled", "not_enrolled", "not_available")

PERMISSIONS:
  android.permission.USE_BIOMETRIC (API 28+) or
  android.permission.USE_FINGERPRINT (API 23-27)

NOTE: Only available on Android 6.0+ (API 23+). Device must have
a fingerprint sensor or other biometric hardware enrolled.

OPTIONS:
  -h              Show this help message.
  -t <title>      Dialog title text.
  -d <desc>       Dialog description text.
  -s <subtitle>   Dialog subtitle text.
  -c <cancel>     Cancel button text.

EXAMPLES:
  # Authenticate with default dialog
  $SCRIPTNAME

  # Authenticate with custom dialog
  $SCRIPTNAME -t "Unlock" -d "Scan your fingerprint" -s "Place finger on sensor"

  # Check auth result
  $SCRIPTNAME | jq '.success'
EOF
    exit 0
}

ARG_T=""
OPT_T=""
ARG_D=""
OPT_D=""
ARG_S=""
OPT_S=""
ARG_C=""
OPT_C=""

while getopts :ht:d:s:c: option
do
    case "$option" in
        h) show_usage;;
        t) ARG_T="--es title";OPT_T="$OPTARG";;
        d) ARG_D="--es description";OPT_D="$OPTARG";;
        s) ARG_S="--es subtitle";OPT_S="$OPTARG";;
        c) ARG_C="--es cancel";OPT_C="$OPTARG";;
        ?) echo "$SCRIPTNAME: illegal option -$OPTARG"; exit 1;
    esac
done

set --
if [ -n "$ARG_T" ]; then set -- "$@" $ARG_T "$OPT_T"; fi
if [ -n "$ARG_D" ]; then set -- "$@" $ARG_D "$OPT_D"; fi
if [ -n "$ARG_S" ]; then set -- "$@" $ARG_S "$OPT_S"; fi
if [ -n "$ARG_C" ]; then set -- "$@" $ARG_C "$OPT_C"; fi

@TERMUX_PREFIX@/bin/termux-api Fingerprint "$@"
