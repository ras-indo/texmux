<?xml version="1.0" encoding="utf-8"?>
<!-- Thin glowing cyan square edge for the header settings/design icon buttons.

     A SINGLE shape with one stroke (no layer-list). The earlier layer-list versions
     rendered as two open vertical brackets with the top and bottom edges missing; a single
     stroke on one well-defined rounded rect is structurally guaranteed to close on all four
     sides. 1.5dp stroke + 6dp radius keeps it a thin, square-ish glowing line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="#B306B6D4" />
    <corners android:radius="6dp" />
</shape>
