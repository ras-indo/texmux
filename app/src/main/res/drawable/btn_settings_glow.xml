<?xml version="1.0" encoding="utf-8"?>
<!-- Header gear/palette buttons, styled to match the NEW SESSION button (btn_new_session):
     same subtle cyan-tinted fill + cyan border so they read as the same family of control.
     Fill/stroke match btn_new_session exactly; radius is 10dp so a 32dp square button keeps
     the same corner proportion as NEW SESSION's 12dp on a 40dp button.
     Single-layer shape (one stroke) — keeps the border closed on all four sides. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1406B6D4" />
    <stroke android:width="1dp" android:color="#4D06B6D4" />
    <corners android:radius="10dp" />
</shape>
