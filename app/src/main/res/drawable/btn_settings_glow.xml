<?xml version="1.0" encoding="utf-8"?>
<!-- Thin glowing cyan square edge for the header settings/design icon buttons.
     Pure STROKE rings only (no filled layers) so it reads as a thin bright line with a
     soft glow, not a thick band. Two concentric rounded-rect strokes: a faint wide outer
     glow ring, and a crisp thin inner edge. Low radii keep it square-ish ("kotak"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft outer glow ring (faint, wide) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="#1F06B6D4" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Crisp thin inner edge (the bright visible line) -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#A606B6D4" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
