<?xml version="1.0" encoding="utf-8"?>
<!-- Thin glowing cyan square edge for the header settings/design icon buttons.
     Single shape, one stroke, low radius — a clean thin square border on all four sides. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="#B306B6D4" />
    <corners android:radius="6dp" />
</shape>
