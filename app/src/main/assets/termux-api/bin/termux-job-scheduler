#!/bin/bash
#
# NAME
#     termux-job-scheduler — Schedule scripts to run at specified intervals
#
# SYNOPSIS
#     termux-job-scheduler [options]
#
# DESCRIPTION
#     Schedule a script to run at specified intervals using Android's
#     JobScheduler API (Android 5.0+, API 21+). JobScheduler is the
#     standard Android mechanism for deferrable, batched background work.
#     Jobs are batched by the system to minimize battery impact, so the
#     actual execution time may be delayed from the scheduled time.
#
#     Supports periodic (repeat every period-ms) and one-shot (default)
#     jobs, network constraints (any, unmetered, cellular, not roaming,
#     none), battery and storage conditions (Android O+), and persisted
#     jobs that survive reboots. Use --job-id to overwrite existing jobs.
#     List pending jobs with --pending and cancel with --cancel or
#     --cancel-all. Output is JSON via termux-api.
#
# OPTIONS
#     -s/--script path              Path to the script to be called
#     --job-id int                  Job id (overwrites previous job with same id)
#     -p/--pending                  List pending jobs and exit
#     --cancel                      Cancel given job-id and exit
#     --cancel-all                  Cancel all pending jobs and exit
#     --period-ms int               Schedule every period-ms (default 0 = once)
#     --network text                Network req: any|unmetered|cellular|not_roaming|none
#     --battery-not-low boolean     Run only when battery not low (Android O+)
#     --storage-not-low boolean     Run only when storage not low (Android O+)
#     --charging boolean            Run only when charging (default false)
#     --persisted boolean           Survive reboots (default false)
#     --trigger-content-uri text    Content URI trigger (Android N+)
#     --trigger-content-flag int    Content trigger flag (default 1, Android N+)
#
# EXAMPLES
#     # Run a script once after 15 minutes
#     termux-job-scheduler --script /path/to/script.sh --period-ms 900000
#
#     # List pending jobs
#     termux-job-scheduler --pending
#
set -e -u -f

SCRIPTNAME=termux-job-scheduler

show_usage () {
	cat <<EOF
Usage: $SCRIPTNAME [options]

Schedule a script to run at specified intervals using Android's
JobScheduler API. Jobs run reliably even if the app is in the
background, and can be constrained by network, battery, storage,
and charging conditions.

NOTE: Since Android N (API 24), the minimum period is 900,000ms
(15 minutes). JobScheduler respects system batching, so intervals
may not be exact.

OUTPUT:
  JSON object with:
    jobId (int) — The ID of the scheduled job (for tracking/cancelling)

PERMISSIONS:
  android.permission.RECEIVE_BOOT_COMPLETED (for --persisted jobs)
  No other special permissions required.

OPTIONS:
  -p, --pending                List all pending/scheduled jobs and exit.
  --cancel-all                 Cancel all pending jobs and exit.
  --cancel <job-id>            Cancel a specific job by ID and exit.

  Scheduling options:
  -s, --script <path>          Path to the script to execute.
  --job-id <int>               Job ID (overwrites any previous job
                               with the same ID).
  --period-ms <int>            Schedule interval in milliseconds.
                               Default: 0 (runs once, not periodic).
                               Min on Android N+: 900000 (15 min).
  --network <type>             Network constraint: any (default),
                               unmetered, cellular, not_roaming, none.
  --battery-not-low <bool>     Run only when battery is not low.
                               Default: true (Android O+, API 26).
  --storage-not-low <bool>     Run only when storage is not low.
                               Default: false (Android O+, API 26).
  --charging <bool>            Run only when charging. Default: false.
  --persisted <bool>           Job survives reboots. Default: false.
                               Requires RECEIVE_BOOT_COMPLETED.
  --trigger-content-uri <uri>  Content URI to watch for changes
                               (Android N+, API 24).
  --trigger-content-flag <int> Content trigger flag. Default: 1
                               (Android N+, API 24).

EXAMPLES:
  # Schedule a script to run once
  $SCRIPTNAME -s /data/data/texmux.app/files/home/backup.sh --job-id 1

  # Schedule a periodic backup every hour (network constrained)
  $SCRIPTNAME -s ~/backup.sh --job-id 2 --period-ms 3600000 --network unmetered

  # List pending jobs
  $SCRIPTNAME --pending

  # Cancel a job
  $SCRIPTNAME --cancel 2
EOF
	exit 0
}

OPT_SCRIPT=""
OPT_JOB_ID=""
OPT_PENDING=""
OPT_CANCEL=""
OPT_CANCEL_ALL=""

OPT_PERIOD_MS=""
OPT_NETWORK=""
OPT_BATTERY_NOT_LOW=""
OPT_STORAGE_NOT_LOW=""
OPT_CHARGING=""
OPT_PERSISTED=""
OPT_TRIGGER_CONTENT_URI=""
OPT_TRIGGER_CONTENT_FLAG=""

TEMP=`getopt \
     -n $SCRIPTNAME \
     -o hs:p \
     --long script:,\
job-id:,pending,\
cancel,cancel-all,\
period-ms:,network:,\
battery-not-low:,storage-not-low:,\
charging:,persisted:,help,\
trigger-content-flag:,trigger-content-uri: \
     -s bash \
     -- "$@"`
eval set -- "$TEMP"

while true; do
	case "$1" in
		-s | --script) OPT_SCRIPT="$2"; shift 2;;
		--job-id) OPT_JOB_ID="$2"; shift 2;;
		-p | --pending) OPT_PENDING=1; shift;;
		--cancel) OPT_CANCEL=1; shift;;
		--cancel-all) OPT_CANCEL_ALL=1; shift;;
		--period-ms) OPT_PERIOD_MS="$2"; shift 2;;
		--network) OPT_NETWORK="$2"; shift 2;;
		--battery-not-low) OPT_BATTERY_NOT_LOW="$2"; shift 2;;
		--storage-not-low) OPT_STORAGE_NOT_LOW="$2"; shift 2;;
		--charging) OPT_CHARGING="$2"; shift 2;;
		--persisted) OPT_PERSISTED="$2"; shift 2;;
		--trigger-content-flag) OPT_TRIGGER_CONTENT_FLAG="$2"; shift 2;;
		--trigger-content-uri) OPT_TRIGGER_CONTENT_URI="$2"; shift 2;;
		-h | --help) show_usage;;
		--) shift; break ;;
	esac
done

if [ $# != 0 ]; then echo "$SCRIPTNAME: too many arguments"; exit 1; fi

set --
if [ -n "$OPT_SCRIPT" ]; then set -- "$@" --es script "$OPT_SCRIPT"; fi
if [ -n "$OPT_JOB_ID" ]; then set -- "$@" --ei job_id "$OPT_JOB_ID"; fi
if [ -n "$OPT_PENDING" ]; then set -- "$@" --ez pending "$OPT_PENDING"; fi
if [ -n "$OPT_CANCEL" ]; then set -- "$@" --ez cancel "$OPT_CANCEL"; fi
if [ -n "$OPT_CANCEL_ALL" ]; then set -- "$@" --ez cancel_all "$OPT_CANCEL_ALL"; fi
if [ -n "$OPT_PERIOD_MS" ]; then set -- "$@" --ei period_ms "$OPT_PERIOD_MS"; fi
if [ -n "$OPT_NETWORK" ]; then set -- "$@" --es network "$OPT_NETWORK"; fi
if [ -n "$OPT_BATTERY_NOT_LOW" ]; then set -- "$@" --ez battery_not_low "$OPT_BATTERY_NOT_LOW"; fi
if [ -n "$OPT_STORAGE_NOT_LOW" ]; then set -- "$@" --ez storage_not_low "$OPT_STORAGE_NOT_LOW"; fi
if [ -n "$OPT_CHARGING" ]; then set -- "$@" --ez charging "$OPT_CHARGING"; fi
if [ -n "$OPT_PERSISTED" ]; then set -- "$@" --ez persisted "$OPT_PERSISTED"; fi
if [ -n "$OPT_TRIGGER_CONTENT_URI" ]; then set -- "$@" --es trigger_content_uri "$OPT_TRIGGER_CONTENT_URI"; fi
if [ -n "$OPT_TRIGGER_CONTENT_FLAG" ]; then set -- "$@" --ez trigger_content_flag "$OPT_TRIGGER_CONTENT_FLAG"; fi

/data/data/texmux.app/files/apps/texmux.app/bin/termux-api JobScheduler "$@"
