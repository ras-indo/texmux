#!/bin/sh
#
# NAME
#     termux-keystore — Manage Android hardware-backed keystore keys
#
# SYNOPSIS
#     termux-keystore <command> [args]
#
# DESCRIPTION
#     Manage keys stored in Android's hardware-backed keystore. Supports
#     listing, deleting, generating, signing, and verifying with RSA
#     and EC keys. Calls termux-api Keystore.
#
# COMMANDS
#     list [-d]              List keys (-d for detailed results)
#     delete <alias>         Permanently delete a key
#     generate <alias>       Create a new key
#       -a alg               Algorithm: RSA or EC (default: RSA)
#       -s size              Key size (RSA: 2048/3072/4096, EC: 256/384/521)
#       -u validity          User validity duration in seconds
#     sign <alias> <algorithm>    Sign data from stdin, output signature to stdout
#     verify <alias> <algorithm> <signature>  Verify signature, data from stdin
#
# EXAMPLES
#     # List all keys
#     termux-keystore list
#
#     # Generate an RSA 2048 key
#     termux-keystore generate myKey -a RSA -s 2048
#
set -e -u

readonly CMD_BASE="/data/data/texmux.app/files/apps/texmux.app/bin/termux-api Keystore"

SCRIPTNAME=termux-keystore

show_list_usage() {
    echo "Usage: $SCRIPTNAME list [-d]"
    echo
    echo "List keys stored in the Android hardware-backed keystore."
    echo "Displays all key aliases available to the calling app."
    echo
    echo "Options:"
    echo "  -d  Detailed output. Includes key parameters such as"
    echo "      algorithm, key size, aliases, purposes, and digests."
    echo
    echo "Output:"
    echo "  JSON-formatted list of key aliases."
    echo "  With -d, includes detailed parameters for each key."
    echo
    echo "Notes:"
    echo "  No special permissions required beyond normal app access."
    echo "  Only keys accessible to the calling app are shown."
}

show_delete_usage() {
    echo "Usage: $SCRIPTNAME delete <alias>"
    echo
    echo "Permanently delete a key from the keystore by its alias."
    echo "This operation cannot be undone."
    echo
    echo "Arguments:"
    echo "  alias  Alias of the key to delete (required)."
    echo
    echo "Output:"
    echo "  JSON indicating success or failure."
    echo
    echo "Exit codes:"
    echo "  0  Key deleted successfully."
    echo "  1  Deletion failed (key not found or permission denied)."
    echo
    echo "Notes:"
    echo "  Only the key alias is deleted; other data is unaffected."
}

show_generate_usage() {
    echo "Usage: $SCRIPTNAME generate <alias> [-a alg] [-s size] [-u validity]"
    echo
    echo "Generate a new key in the Android hardware-backed keystore."
    echo "Keys are stored securely and cannot be extracted."
    echo
    echo "Arguments:"
    echo "  alias       Name for the new key (required)."
    echo
    echo "Options:"
    echo "  -a alg      Algorithm: RSA or EC (default: RSA)."
    echo "  -s size     Key size:"
    echo "              RSA:  2048, 3072, or 4096 (default: 2048)."
    echo "              EC:   256, 384, or 521 (default: 256)."
    echo "  -u validity User authentication validity in seconds."
    echo "              0 = no authentication required (default)."
    echo "              When set, key use is limited to the specified"
    echo "              duration after device unlock."
    echo
    echo "Output:"
    echo "  JSON object with alias and generation status."
    echo
    echo "Notes:"
    echo "  Keys are hardware-backed if the device supports it."
    echo "  Generated keys cannot be extracted or exported."
    echo "  The key is created with SIGN+VERIFY purpose by default."
}

show_sign_usage() {
    echo "Usage: $SCRIPTNAME sign <alias> <algorithm>"
    echo
    echo "Sign data using a key stored in the keystore."
    echo "Data is read from stdin; the signature is output to stdout."
    echo
    echo "Arguments:"
    echo "  alias      Alias of the key to use for signing (required)."
    echo "  algorithm  Algorithm for signing, e.g. SHA256withRSA,"
    echo "             SHA384withRSA, SHA256withECDSA."
    echo
    echo "Input:"
    echo "  Data to sign is read from stdin."
    echo
    echo "Output:"
    echo "  Base64-encoded signature written to stdout."
    echo
    echo "Notes:"
    echo "  The key must exist and support signing operations."
    echo "  The algorithm must be compatible with the key type."
}

show_verify_usage() {
    echo "Usage: $SCRIPTNAME verify <alias> <algorithm> <signature>"
    echo
    echo "Verify a signature against original data using a keystore key."
    echo
    echo "Arguments:"
    echo "  alias      Alias of the key used for verification (required)."
    echo "  algorithm  Algorithm that was used to sign, e.g."
    echo "             SHA256withRSA, SHA256withECDSA."
    echo "  signature  Path to the signature file to verify."
    echo
    echo "Input:"
    echo "  The original data is read from stdin."
    echo
    echo "Output:"
    echo "  JSON object with verification result (true or false)."
    echo
    echo "Notes:"
    echo "  The key must match the one used to create the signature."
    echo "  The algorithm must match the one used during signing."
}

show_usage () {
    echo "Usage: $SCRIPTNAME command"
    echo "These commands are supported:"
    echo "  list [-d]"
    echo "  delete <alias>"
    echo "  generate <alias> [-a alg] [-s size] [-u validity]"
    echo "  sign <alias> <algorithm>"
    echo "  verify <alias> <algorithm> <signature>"
    echo
    echo "list: List the keys stored inside the keystore."
    echo "  -d           Detailed results (includes key parameters)."
    echo
    echo "delete: Permanently delete a given key from the keystore."
    echo "  alias        Alias of the key to delete."
    echo
    echo "generate: Create a new key inside the hardware keystore."
    echo "  alias        Alias of the key."
    echo "  -a alg       Algorithm to use (either 'RSA' or 'EC'). Defaults to RSA."
    echo "  -s size      Key size to use. For RSA, the options are 2048, 3072"
    echo "               and 4096. For EC, the options are 256, 384 and 521."
    echo "  -u validity  User validity duration in seconds. Omit to disable."
    echo "               When enabled, the key can only be used for the"
    echo "               duration specified after the device unlocks. After"
    echo "               the duration has passed, the user needs to re-lock"
    echo "               and unlock the device again to be able to use this key."
    echo
    echo "sign: Sign using the given key, the data is read from stdin and the"
    echo "signature is output to stdout."
    echo "  alias        Alias of the key to use for signing."
    echo "  algorithm    Algorithm to use, e.g. 'SHA256withRSA'. This should"
    echo "               match the algorithm of the key."
    echo
    echo "verify: Verify a signature. The data (original file) is read from stdin."
    echo "  alias        Alias of the key to use for verify."
    echo "  algorithm    Algorithm that was used to sign this data."
    echo "  signature    Signature file to use in verification."
}


check_args () {
    if [ "$2" != "$3" ]; then
        echo "$SCRIPTNAME: $1 needs exactly $2 arguments"
        exit 1
    fi
}

list_keys () {
    if [ "$#" -gt 0 ] && [ "$1" = "-d" ]; then
        $CMD_BASE -e command list --ez detailed true
    else
        $CMD_BASE -e command list
    fi
}

delete_key () {
    check_args delete 1 $# 
    $CMD_BASE -e command delete -e alias "$1"
}

sign_data () {
    check_args sign 2 $#
    $CMD_BASE -e command sign -e alias "$1" -e algorithm "$2" | base64 -d
}

verify_data () {
    check_args verify 3 $#
    $CMD_BASE -e command verify -e alias "$1" -e algorithm "$2" \
        -e signature "$(realpath "$3")"
}

generate_key () {
    if [ $# -lt 1 ]; then
        echo "$SCRIPTNAME generate: alias argument is required"
        exit 1
    fi
    ALIAS=$1; shift
    ALGORITHM=RSA; SIZE=-1; CURVE=secp256r1; VALIDITY=0
    while getopts a:s:c:u: NAME; do
        case "$NAME" in
            a) ALGORITHM=$OPTARG ;;
            s) SIZE=$OPTARG ;;
            u) VALIDITY=$OPTARG ;;
            ?) ;;
        esac
    done

    if [ "$ALGORITHM" = "RSA" ]; then
        case "$SIZE" in
            -1) SIZE=2048 ;;
            2048|3072|4096) ;;
            *) echo "$SCRIPTNAME: invalid RSA key size $SIZE"; exit 1 ;;
        esac
    elif [ "$ALGORITHM" = "EC" ]; then
        case "$SIZE" in
            -1|256) CURVE=secp256r1 ;;
            384) CURVE=secp384r1 ;;
            521) CURVE=secp521r1 ;;
            *) echo "$SCRIPTNAME: invalid EC key size $SIZE"; exit 1 ;;
        esac
    else
        echo "$SCRIPTNAME: invalid algorithm $ALGORITHM"; exit 1
    fi

    # purpose 12 is SIGN+VERIFY
    $CMD_BASE -e command generate -e alias "$ALIAS" -e algorithm "$ALGORITHM" \
        --ei purposes 12 --esa digests NONE,SHA-1,SHA-256,SHA-384,SHA-512 \
        --ei size "$SIZE" -e curve "$CURVE" --ei validity "$VALIDITY"
}

ACTION="${1-}"
if [ "$#" -gt 0 ]; then shift; fi

# Check for -h/--help per command
for arg; do
    case "$arg" in
        -h|--help)
            case "$ACTION" in
                list)     show_list_usage ;;
                generate) show_generate_usage ;;
                delete)   show_delete_usage ;;
                sign)     show_sign_usage ;;
                verify)   show_verify_usage ;;
                *)        show_usage ;;
            esac
            exit 0 ;;
    esac
    break  # only check first arg after command
done

case "$ACTION" in
    list) list_keys "$@" ;;
    generate) generate_key "$@" ;;
    delete) delete_key "$@" ;;
    sign) sign_data "$@" ;;
    verify) verify_data "$@" ;;
    *) show_usage ;;
esac
