#!/bin/sh
#
# NAME
#     termux-permission — Show and request the permissions Termux:API needs
#
# SYNOPSIS
#     termux-permission status
#     termux-permission request [--permissions <key[,key]>] [--reason <text>]
#
# DESCRIPTION
#     Android has three flavours of permission and only one has a popup:
#
#         runtime     the standard Allow/Deny dialog
#         settings    "special app access" — no popup exists at all, only a
#                     dedicated settings page
#         privileged  signature|privileged — cannot be granted at runtime
#
#     "status" reports every permission this app can need, whether it is
#     currently granted, and how it would be granted.
#
#     "request" asks Android itself for what is missing:
#       - runtime permissions go through the system Allow/Deny dialog,
#       - special access deep-links the exact settings page,
#       - privileged permissions are reported as impossible at runtime.
#     There is no prompt of our own: the platform dialog is the interface.
#     The request returns immediately - answer the dialog, then run the
#     command again.
#
#     Commands that need a permission use the same path: they answer with a
#     JSON error listing "needs_permission" and Android shows its dialog.
#     Commands that need a radio switched on queue that dialog too, so one run
#     can show the permission dialog and then "turn on Bluetooth?".
#
# OPTIONS
#     --permissions <keys>  Comma separated keys to request, e.g.
#                           bluetooth_scan,bluetooth_connect. Default: every
#                           missing permission.
#     --reason <text>       Accepted for compatibility; there is no in-app
#                           prompt left that could display it.
#     -h, --help            Display this help message and exit.
#
# OUTPUT (status)
#     {
#       "permissions": [ { "key", "permission", "label", "kind", "granted",
#                          "how_to" } ],
#       "missing": [ "..." ],
#       "missing_grantable": [ "..." ],
#       "missing_privileged": [ "..." ],
#       "all_granted": true|false
#     }
#
# OUTPUT (request)
#     Everything already granted:
#       { "all_granted": true, "message": "..." }
#     Something missing (the system dialog is shown at the same time):
#       { "error": "Please grant ...", "hint": "...",
#         "needs_permission": [ "android.permission.CAMERA" ] }
#
# EXAMPLES
#     # What is still missing?
#     termux-permission status | jq '.missing'
#
#     # Ask for the two Bluetooth permissions only
#     termux-permission request --permissions bluetooth_scan,bluetooth_connect
#
#     # Ask for everything that is still missing
#     termux-permission request
#
#     # Why does hotspot-enable keep failing?
#     termux-permission status | jq '.missing_privileged'
#
set -e -u

SCRIPTNAME=termux-permission

show_usage () {
    cat <<EOF
Usage: $SCRIPTNAME <status|request> [options]

Show which permissions Termux:API holds, or ask for the missing ones through
Android's own dialog (no need to dig through the system settings app).

  status     list every permission with granted state and how it is granted
  request    show the system dialog for runtime permissions and open the
             settings page for special access; then run the command again

Options for request:
  --permissions <keys>   comma separated, e.g. bluetooth_scan,bluetooth_connect
                         (default: every missing permission)
  --reason <text>        accepted for compatibility, not displayed

Kinds:
  runtime     standard Allow/Deny dialog
  settings    special app access, opened directly on the right page
  privileged  cannot be granted at runtime (needs priv-app install + root)

Examples:
  $SCRIPTNAME status
  $SCRIPTNAME status | jq '.missing_grantable'
  $SCRIPTNAME request
  $SCRIPTNAME request --permissions bluetooth_connect --reason "buat pairing"
EOF
    exit 0
}

call_api () {
    local API_METHOD="$1"
    shift
    local result
    if ! result="$(termux-api Permission "$@")"; then
        local errmsg="Failed to execute the termux-api command. Is Termux:API installed?"
        if [ -n "${result:-}" ]; then errmsg="$errmsg\n$result"; fi
        echo -e "$errmsg" >&2
        exit 1
    fi
    echo "$result"
}

status_cmd() {
    call_api status --es subcommand status
}

request_cmd() {
    local permissions="" reason=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) show_usage ;;
            --permissions) permissions="${2:-}"; shift 2 ;;
            --reason)      reason="${2:-}"; shift 2 ;;
            *) echo "Unknown option: $1" >&2; exit 1 ;;
        esac
    done

    if [ -n "$permissions" ]; then
        call_api request --es subcommand request --es permissions "$permissions" ${reason:+--es reason "$reason"}
    else
        call_api request --es subcommand request ${reason:+--es reason "$reason"}
    fi
}

if [ $# -eq 0 ]; then
    show_usage
fi

CMD="$1"
shift

case "$CMD" in
    -h|--help) show_usage ;;
    status)    status_cmd ;;
    request)   request_cmd "$@" ;;
    *)
        echo "Unknown command: $CMD" >&2
        show_usage
        ;;
esac
