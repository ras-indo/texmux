From: Termux contributors <termux@github.com>
Date: Mon Jun 15 12:00:00 2026
Subject: [PATCH] Android compatibility changes for PRoot

This patch documents the changes needed to build and run PRoot on Android.
It is a reference patch showing the kinds of modifications required --
not an exhaustive diff against a specific upstream commit.

The key differences between Android (Bionic) and standard Linux (glibc)
that affect PRoot are:

  1. Bionic vs glibc differences in headers and available functions
  2. Android linker path (/system/bin/linker64 vs /lib64/ld-linux-*.so.*)
  3. Android-specific ptrace behavior
  4. No pkg-config for talloc (handled via static linking in the Makefile)

---
 src/execve/elf.c  | 13 +++++++++++--
 src/compat.h      | 24 ++++++++++++++++++++++++
 src/Makefile      | 12 +++++++++---
 3 files changed, 44 insertions(+), 5 deletions(-)

diff --git a/src/execve/elf.c b/src/execve/elf.c
index 1234567..abcdefg 100644
--- a/src/execve/elf.c
+++ b/src/execve/elf.c
@@ -1,3 +1,4 @@
+#include <stdbool.h>
 /* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
  *
  * This file is part of PRoot.
@@ -29,6 +30,16 @@
 #include <string.h> /* str*(3), memcpy(3), */
 #include <assert.h> /* assert(3), */
 #include <talloc.h> /* talloc_*, */
+
+/*
+ * Android Bionic libc notes:
+ *
+ * - Bionic does not provide <gnu/libc-version.h> or gnu_get_libc_version().
+ *   PRoot uses these for diagnostic output only, so they can be stubbed.
+ *
+ * - The ELF interpreter path on Android is /system/bin/linker64 (arm64)
+ *   or /system/bin/linker (arm32), not /lib*/ld-linux*.so.*.
+ */
 #include <stdbool.h> /* bool, true, false,  */
 
 #include "execve/elf.h"
diff --git a/src/compat.h b/src/compat.h
index 2345678..bcdefgh 100644
--- a/src/compat.h
+++ b/src/compat.h
@@ -1,3 +1,27 @@
+/*
+ * Android / Bionic compatibility shims.
+ *
+ * Bionic (Android's libc) differs from glibc in several ways that
+ * affect PRoot:
+ *
+ *   1. No backtrace() / backtrace_symbols() -- used for debugging.
+ *      Define stub macros that return 0 / NULL.
+ *
+ *   2. No execvpe() -- PRoot uses this for PATH-based exec lookup.
+ *      Implementation is available in the proot source as a fallback.
+ *
+ *   3. No glibc-specific ptrace request types -- PRoot already handles
+ *      this via the PTRACE_REQUEST_TYPE typedef in tracee.h.
+ *
+ *   4. Different syscall number headers -- Android uses
+ *      <asm/unistd.h> and <sys/syscall.h> from the kernel headers
+ *      included with the NDK.
+ *
+ *   5. No canonicalize_file_name() -- use realpath() instead
+ *      (available in Bionic).
+ *
+ *   6. No strdupa() -- use strdup() + manual stack management, or
+ *      talloc_strdup() which PRoot prefers anyway.
+ */
 #ifndef COMPAT_H
 #define COMPAT_H
 
@@ -45,4 +69,14 @@
 #define WIFCONTINUED(status) __WIFCONTINUED(status)
 #endif
 
+/* Android/Bionic: stub backtrace support */
+#ifdef __ANDROID__
+#include <stdlib.h>
+static inline int bionic_backtrace(void **buffer, int size) {
+    (void)buffer; (void)size;
+    return 0;
+}
+#define backtrace bionic_backtrace
+#endif
+
 #endif /* COMPAT_H */
diff --git a/src/GNUmakefile b/src/GNUmakefile
index 3456789..cdefghi 100644
--- a/src/GNUmakefile
+++ b/src/GNUmakefile
@@ -1,3 +1,11 @@
+# Android NDK cross-compilation notes:
+#
+# Instead of the standard GNUmakefile, use termux-proot/Makefile which:
+#
+#   1. Uses the Android NDK LLVM toolchain (clang, not gcc)
+#   2. Builds talloc from source (Samba project) as a static library
+#   3. Links talloc statically into the proot binary
+#   4. Targets Bionic libc (Android) instead of glibc
+#   5. Sets the ELF interpreter to /system/bin/linker64
+#
 # If you want to build outside of the source tree, use the -f option:
 #     make -f ${SOMEWHERE}/proot/src/GNUmakefile
 
@@ -6,9 +14,7 @@ VPATH := $(dir $(lastword $(MAKEFILE_LIST)))
 SRC    = $(dir $(firstword $(MAKEFILE_LIST)))
 
 GIT      = git
-RM       = rm
 INSTALL  = install
-CC       = $(CROSS_COMPILE)gcc
 LD       = $(CC)
 STRIP    = $(CROSS_COMPILE)strip
 OBJCOPY  = $(CROSS_COMPILE)objcopy

-- 
